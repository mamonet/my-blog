---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Get all blog posts
const allPosts = await getCollection('blog');
const publishedPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Group posts by year and month
interface PostsByMonth {
  [year: string]: {
    [month: string]: typeof publishedPosts;
  };
}

const postsByMonth: PostsByMonth = {};

publishedPosts.forEach(post => {
  const date = new Date(post.data.pubDate);
  const year = date.getFullYear().toString();
  const month = date.toLocaleDateString('en-US', { month: 'long' });
  
  if (!postsByMonth[year]) {
    postsByMonth[year] = {};
  }
  
  if (!postsByMonth[year][month]) {
    postsByMonth[year][month] = [];
  }
  
  postsByMonth[year][month].push(post);
});

// Sort years in descending order
const sortedYears = Object.keys(postsByMonth).sort((a, b) => parseInt(b) - parseInt(a));

// Month order for sorting
const monthOrder = ['January', 'February', 'March', 'April', 'May', 'June', 
                    'July', 'August', 'September', 'October', 'November', 'December'];
---

<BaseLayout 
  title="Archive - Security Blog"
  description="Browse all articles organized by year and month. Find security research, cryptography guides, and reverse engineering tutorials."
>
  <Header />
  
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Page Header -->
    <div class="mb-12">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-gray-900 dark:text-white">
        Archive
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-400">
        Browse {publishedPosts.length} articles organized by date
      </p>
    </div>

    <!-- Archive by Year/Month -->
    <div class="space-y-12">
      {sortedYears.map(year => {
        const months = Object.keys(postsByMonth[year]).sort((a, b) => 
          monthOrder.indexOf(b) - monthOrder.indexOf(a)
        );
        
        return (
          <section>
            <!-- Year Header -->
            <h2 class="text-3xl font-bold mb-6 text-gray-900 dark:text-white flex items-center">
              <span class="text-primary-600 dark:text-primary-400">{year}</span>
              <span class="ml-4 text-sm font-normal text-gray-500 dark:text-gray-500">
                ({Object.values(postsByMonth[year]).flat().length} articles)
              </span>
            </h2>

            <!-- Months -->
            <div class="space-y-8">
              {months.map(month => {
                const posts = postsByMonth[year][month];
                
                return (
                  <div>
                    <!-- Month Header -->
                    <h3 class="text-xl font-semibold mb-4 text-gray-700 dark:text-gray-300 flex items-center">
                      {month}
                      <span class="ml-3 text-sm font-normal text-gray-500 dark:text-gray-500">
                        {posts.length} article{posts.length !== 1 ? 's' : ''}
                      </span>
                    </h3>

                    <!-- Posts List -->
                    <div class="space-y-4 pl-6 border-l-2 border-gray-200 dark:border-gray-800">
                      {posts.map(post => {
                        const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
                          month: 'short',
                          day: 'numeric',
                        });
                        
                        return (
                          <article class="group">
                            <a 
                              href={`/blog/${post.slug}`}
                              class="block hover:bg-gray-50 dark:hover:bg-gray-800/50 -ml-6 pl-6 pr-4 py-3 rounded-r-lg transition-colors"
                            >
                              <div class="flex items-start justify-between gap-4">
                                <div class="flex-1 min-w-0">
                                  <h4 class="font-semibold text-gray-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors mb-1">
                                    {post.data.title}
                                  </h4>
                                  <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">
                                    {post.data.description}
                                  </p>
                                  {post.data.tags.length > 0 && (
                                    <div class="flex flex-wrap gap-2 mt-2">
                                      {post.data.tags.slice(0, 3).map(tag => (
                                        <span class="text-xs px-2 py-1 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded">
                                          {tag}
                                        </span>
                                      ))}
                                    </div>
                                  )}
                                </div>
                                <div class="flex flex-col items-end text-sm text-gray-500 dark:text-gray-500 whitespace-nowrap">
                                  <time datetime={post.data.pubDate.toISOString()}>
                                    {formattedDate}
                                  </time>
                                </div>
                              </div>
                            </a>
                          </article>
                        );
                      })}
                    </div>
                  </div>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>

    {publishedPosts.length === 0 && (
      <div class="text-center py-12">
        <div class="text-6xl mb-4">📝</div>
        <h2 class="text-2xl font-bold mb-2 text-gray-900 dark:text-white">No articles yet</h2>
        <p class="text-gray-600 dark:text-gray-400">
          Check back later for new content!
        </p>
      </div>
    )}

    <!-- Back to Blog Link -->
    <div class="mt-12 text-center">
      <a
        href="/blog"
        class="inline-flex items-center text-primary-600 dark:text-primary-400 hover:underline font-medium"
      >
        ← View all articles
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>