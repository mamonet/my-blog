---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';

// Get all blog posts
const allPosts = await getCollection('blog');
const publishedPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Get unique tags
const allTags = [...new Set(publishedPosts.flatMap(post => post.data.tags))].sort();

// Get query parameters for filtering
const urlParams = Astro.url.searchParams;
const selectedTag = urlParams.get('tag');
const sortOrder = urlParams.get('sort') || 'latest';

// Filter posts by tag if selected
let filteredPosts = selectedTag
  ? publishedPosts.filter(post => post.data.tags.includes(selectedTag))
  : publishedPosts;

// Sort posts
if (sortOrder === 'oldest') {
  filteredPosts = filteredPosts.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
} else {
  filteredPosts = filteredPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
}

// Calculate reading time
function calculateReadingTime(content: string) {
  const wordsPerMinute = 200;
  const words = content.split(/\s+/).length;
  const minutes = Math.ceil(words / wordsPerMinute);
  return `${minutes} min read`;
}
---

<BaseLayout 
  title={selectedTag ? `Articles tagged with "${selectedTag}" - Security Blog` : 'All Articles - Security Blog'}
  description={selectedTag ? `Browse all security articles tagged with ${selectedTag}` : 'Browse all technical articles about cryptography, security, reverse engineering, and vulnerabilities'}
>
  <Header />
  
  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Page Header -->
    <div class="mb-12">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-gray-900 dark:text-white">
        {selectedTag ? `Articles tagged with "${selectedTag}"` : 'All Articles'}
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-400">
        {selectedTag 
          ? `${filteredPosts.length} article${filteredPosts.length !== 1 ? 's' : ''} found`
          : `Browse all ${publishedPosts.length} articles`
        }
      </p>
    </div>

    <!-- Filters and Sort -->
    <div class="mb-8 space-y-4">
      <!-- Sort Options -->
      <div class="flex flex-wrap items-center gap-4">
        <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Sort by:</span>
        <div class="flex gap-2">
          <a
            href={selectedTag ? `/blog?tag=${selectedTag}&sort=latest` : '/blog?sort=latest'}
            class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors ${
              sortOrder === 'latest'
                ? 'bg-primary-600 text-white'
                : 'bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-700'
            }`}
          >
            Latest
          </a>
          <a
            href={selectedTag ? `/blog?tag=${selectedTag}&sort=oldest` : '/blog?sort=oldest'}
            class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors ${
              sortOrder === 'oldest'
                ? 'bg-primary-600 text-white'
                : 'bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-700'
            }`}
          >
            Oldest
          </a>
        </div>
        {selectedTag && (
          <a
            href="/blog"
            class="px-4 py-2 rounded-lg text-sm font-medium bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-700 transition-colors"
          >
            Clear filter ✕
          </a>
        )}
      </div>

      <!-- Tag Filter -->
      <div>
        <span class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3 block">Filter by topic:</span>
        <div class="flex flex-wrap gap-2">
          <a
            href="/blog"
            class={`text-sm px-4 py-2 rounded-lg transition-colors ${
              !selectedTag
                ? 'bg-primary-600 text-white'
                : 'bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-700'
            }`}
          >
            All Topics
          </a>
          {allTags.map((tag) => (
            <a
              href={`/blog?tag=${tag}`}
              class={`text-sm px-4 py-2 rounded-lg transition-colors ${
                selectedTag === tag
                  ? 'bg-primary-600 text-white'
                  : 'bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-700'
              }`}
            >
              {tag}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Articles Grid -->
    {filteredPosts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {filteredPosts.map((post) => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.slug}
            tags={post.data.tags}
            readingTime={calculateReadingTime(post.body)}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-12">
        <div class="text-6xl mb-4">📝</div>
        <h2 class="text-2xl font-bold mb-2 text-gray-900 dark:text-white">No articles found</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-6">
          Try selecting a different tag or check back later for new content.
        </p>
        <a
          href="/blog"
          class="inline-block px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white rounded-lg font-medium transition-colors"
        >
          View all articles
        </a>
      </div>
    )}
  </main>

  <Footer />
</BaseLayout>